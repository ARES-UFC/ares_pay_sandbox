# Copie este arquivo para .env e preencha com as credenciais de teste do Stripe.
# Utilize exclusivamente chaves de teste (prefixos sk_test_, pk_test_ e whsec_).
# Nunca utilize credenciais de produção.

# Chave secreta de teste (obtida no Dashboard em Developers > API keys)
STRIPE_SECRET_KEY=sk_test_xxx

# Chave pública de teste (utilizada na interface do navegador)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Segredo do webhook (obtido no Dashboard em Developers > Webhooks ou via Stripe CLI com stripe listen)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Porta HTTP da aplicação
PORT=3000

# Caminho para o arquivo do banco de dados SQLite (já incluído no .gitignore)
DB_PATH=./data/ares_pay.db
